{
  "name": "interactive-narrative-deck-tests",
  "version": "1.0.0",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:antipatterns": "node tests/antipattern-detector.test.js"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@testing-library/dom": "^9.3.4",
    "jsdom": "^23.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "engine/**/*.js",
      "!engine/vendor/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 75,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
